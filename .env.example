# Copy to .env and fill in. Never commit .env.

# ---- Public access ----
# or :80 to serve plain HTTP on the IP
DOMAIN=wa.example.com
# mutating API calls must come from here
PUBLIC_ORIGIN=https://wa.example.com
# only for BUS_DRIVER=kafka: uncomment together with BUS_DRIVER=kafka below (costs ~1 GB RAM)
# COMPOSE_PROFILES=kafka

# ---- Console auth ----
# openssl rand -hex 32
JWT_SECRET=
ADMIN_USERNAME=admin
# first boot only; if empty a one-time password is logged
ADMIN_PASSWORD=
SESSION_TTL_HOURS=168
# false only for plain-HTTP testing
COOKIE_SECURE=true

# ---- Datastores ----
POSTGRES_USER=wa
# openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=wa
# Local dev only (compose sets these for containers):
DATABASE_URL=postgres://wa:wa@localhost:5432/wa
REDIS_URL=redis://localhost:6379

# ---- Message bus ----
# redis (default: lighter, no extra container) | kafka (needs COMPOSE_PROFILES=kafka)
BUS_DRIVER=redis
KAFKA_BROKERS=localhost:9092
KAFKA_PARTITIONS=3

# ---- LLM (Ollama, CPU) ----
OLLAMA_URL=http://localhost:11434
# Ollama image tag used by docker-compose (pinned so every deploy runs the same version)
OLLAMA_VERSION=0.40.14
# default model; switch live in the console
LLM_MODEL=gemma3:4b
# smaller = faster prompt processing on CPU
LLM_NUM_CTX=4096
# CPU threads per generation: 8 on the 8 vCPU KVM (0 = let Ollama decide, often fewer)
LLM_NUM_THREAD=8
# parallel generations (= OLLAMA_NUM_PARALLEL)
LLM_CONCURRENCY=1
# keep the model loaded forever
LLM_KEEP_ALIVE=-1
LLM_AUTO_PULL=true

# ---- Groq (hosted LLM, optional) ----
# Several keys rotate: a rate-limited key is skipped instantly and the next is used; when all are used up the local
# model answers. Comma/space/newline separated. Keys can also be added in the console (Settings -> AI provider), where
# they are stored encrypted. Select the provider in the console; this only supplies keys.
GROQ_API_KEYS=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# parallel Groq calls (the hosted model is not CPU-bound; the keys' own rate limits are the real cap)
GROQ_CONCURRENCY=32
# a Groq call fails over after this long with no data
GROQ_TIMEOUT_MS=30000

# ---- Retrieval ----
KB_TOP_K=4
KB_MAX_CONTEXT_TOKENS=900
KB_MIN_SCORE=2.2

# ---- WhatsApp ----
WA_AUTO_CONNECT=true
WA_CLIENT_ID=main
# pin a WhatsApp Web build only if the latest breaks
WA_WEB_VERSION=

# ---- Misc ----
LOG_LEVEL=info
# short-term memory per chat (6h)
CONTEXT_TTL_SEC=21600
# memoized answers (12h, auto-invalidated on KB edits)
ANSWER_CACHE_TTL_SEC=43200

# ---- CI/CD (set by the deploy workflow; leave empty locally) ----
APP_IMAGE=

# Cloudflare Workers AI: second hosted provider after Groq (free: 10,000 neurons/day per account, resets 00:00 UTC).
# Format ACCOUNT_ID:API_TOKEN, comma separated for several accounts. More can be added in the console.
CLOUDFLARE_API_KEYS=
CLOUDFLARE_CONCURRENCY=8
