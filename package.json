{
  "name": "whatsapp-ai-assistant",
  "version": "2.1.0",
  "description": "Self-hosted WhatsApp AI assistant: vectorless RAG + local LLM (Ollama), web console, Kafka/Redis/Postgres.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start:gateway": "node src/gateway/index.js",
    "start:worker": "node src/worker/index.js",
    "dev:gateway": "node --watch --env-file-if-exists=.env src/gateway/index.js",
    "dev:worker": "node --watch --env-file-if-exists=.env src/worker/index.js",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test",
    "eval": "node --env-file-if-exists=.env scripts/eval.js",
    "bench": "node --env-file-if-exists=.env scripts/bench-models.js",
    "kb:search": "node --env-file-if-exists=.env scripts/kb-search.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "whatsapp-web.js": "^1.31.0"
  }
}
